mixin page-section(data={})
  //- Секция страницы
  //- fill: boolean = false
  //- className?: string | null = null
  //- role?: string | null = null
  section.page-section(
    class=data.className,
    class=(data.fill && "page-section--fill")
    data-role=data.role,
  )
    .container
      block
